{
  "name": "resume-analyzer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:server": "ts-node --project tsconfig.server.json backend/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build:next": "next build",
    "build:server": "tsc --project tsconfig.server.json",
    "build": "npm run build:next && npm run build:server",
    "start:next": "next start",
    "start:server": "node dist-server/backend/index.js",
    "start": "concurrently \"npm run start:next\" \"npm run start:server\"",
    "lint": "next lint"
  },
  "dependencies": {
    "@clerk/backend": "^3.4.13",
    "@clerk/express": "^2.1.20",
    "@clerk/nextjs": "^6.28.1",
    "@huggingface/inference": "^4.13.18",
    "@qdrant/js-client-rest": "^1.18.0",
    "@textlint/textlint-plugin-markdown": "^15.2.1",
    "@types/uuid": "^10.0.0",
    "bullmq": "^5.77.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.536.0",
    "mammoth": "^1.12.0",
    "mongodb": "^7.2.0",
    "next": "15.4.8",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "openai": "^5.11.0",
    "pdf-parse": "^1.1.1",
    "pdf2json": "^3.2.0",
    "pdfjs-dist": "^5.7.284",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "text-readability": "^1.1.1",
    "textstat": "^0.8.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "15.4.5",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
